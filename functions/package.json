{
  "name": "chatsnap-functions",
  "version": "0.1.0",
  "description": "Chatsnap Cloud Functions (all product rules live here).",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "test": "firebase emulators:exec --project chatsnap-dev --only firestore,auth,storage 'vitest run'",
    "test:watch": "firebase emulators:exec --project chatsnap-dev --only firestore,auth,storage 'vitest'",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "private": true
}
