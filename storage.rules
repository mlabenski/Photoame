rules_version = '2';

// Photoame Cloud Storage rules.
// Snap blobs live at snaps/{pairId}/{snapId}.jpg. Only the sender may write,
// only pair members may read. Deletion is server-side (sweepExpired / endPair).

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function pairMembers(pairId) {
      return firestore.get(/databases/(default)/documents/pairs/$(pairId)).data.members;
    }

    match /snaps/{pairId}/{snapId} {
      allow read: if isSignedIn() && request.auth.uid in pairMembers(pairId);

      allow create: if isSignedIn()
        && request.auth.uid in pairMembers(pairId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if false;
    }
  }
}
