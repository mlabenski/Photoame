rules_version = '2';

// Photoame Cloud Storage rules.
// Snap blobs live at snaps/{pairId}/{snapId}.{jpg,heic,mp4}. Only the sender may
// write, only pair members may read. Photos are capped at 5 MB; videos (max 10 s,
// transcoded client-side) at 60 MB. Deletion is server-side (sweepExpired / endPair).

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function pairMembers(pairId) {
      return firestore.get(/databases/(default)/documents/pairs/$(pairId)).data.members;
    }

    match /snaps/{pairId}/{snapId} {
      allow read: if isSignedIn() && request.auth.uid in pairMembers(pairId);

      allow create: if isSignedIn()
        && request.auth.uid in pairMembers(pairId)
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size < 60 * 1024 * 1024)
        );

      allow update, delete: if false;
    }

    // Profile pictures (avatars) live at avatars/{uid}.jpg. Any signed-in user
    // may read one (so a paired partner can display it); only the owner may
    // write their own, capped small since avatars are downscaled client-side.
    match /avatars/{avatarId} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
        && avatarId == request.auth.uid + '.jpg'
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
